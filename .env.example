# Скопіюйте у .env і за потреби змініть.
DATABASE_URL=postgres://quiz:quiz@localhost:5433/quiz
# Довгий випадковий рядок (щонайменше 32 символи); ним підписуються сесії.
# Згенерувати: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Адреса, за якою відкривається застосунок.
BETTER_AUTH_URL=http://localhost:3000
# Додаткові адреси клієнта через кому (сервер розробки Vite).
TRUSTED_ORIGINS=http://localhost:5173

# Зображення до запитань. Типово лежать у теці apps/server/uploads.
# UPLOAD_DIR=/var/data/quiz-uploads
# Або Cloudflare R2 (потрібні всі чотири змінні):
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
